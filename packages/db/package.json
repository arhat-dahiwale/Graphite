    "setup": "tsx src/run-setup.ts"
  },
  "dependencies": {
    "@graphite/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
