{
  "name": "@graphite/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./repo/*": "./src/repo/*.ts",
    "./setup": "./src/setup.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
