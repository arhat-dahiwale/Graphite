# ---- Core services ----
DATABASE_URL=postgres://graphite_app:app_password@localhost:5433/graphite
# Admin connection used for migrations and role/schema setup only
DATABASE_ADMIN_URL=postgres://graphite:graphite@localhost:5433/graphite
# Read-only role: every user-visible SQL query runs through this account
DATABASE_READONLY_URL=postgres://graphite_readonly:readonly_password@localhost:5433/graphite
REDIS_URL=redis://localhost:6380

# ---- Object storage (MinIO / S3) ----
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=graphite-uploads
S3_FORCE_PATH_STYLE=true

# ---- Auth (Better Auth) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-a-real-secret
BETTER_AUTH_URL=http://localhost:4000
# Optional OAuth providers (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Browser origins (CORS + Socket.IO) ----
# Comma-separated explicit origins. '*' is rejected because credentials
# (cookies) are always enabled.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- URLs / ports ----
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
API_PORT=4000
WEB_PORT=3000
DATA_GRPC_PORT=50051
# Internal-only port the agent-run worker mounts the MCP server on
# Internal-only: signs the internal MCP identity headers (agent runs). No default;
# startup fails if missing or shorter than 32 characters. Generate: openssl rand -base64 32
INTERNAL_MCP_SECRET=dev-only-internal-mcp-secret-0123456789abcdef
WORKER_INTERNAL_MCP_PORT=4100

# ---- LLM ----
# mock (default when no provider key is set) | anthropic
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Token budget per agent run (input+output tokens)
AGENT_TOKEN_BUDGET=200000

# ---- Agent run queue ----
AGENT_RUN_CONCURRENCY=2

# ---- Limits ----
# Per-token MCP request rate limit (req/min)
MCP_TOKEN_RATE_LIMIT=120
# Per-user API rate limit (req/min); 0 disables
USER_REQUESTS_PER_MIN=300
# Org agent-run quota per hour
ORG_RUNS_PER_HOUR=30
MAX_UPLOAD_MB=50
MAX_QUERY_ROWS=5000
STATEMENT_TIMEOUT_MS=10000

# ---- Observability ----
LOG_LEVEL=info
# OpenTelemetry: enable tracing and where to send it (OTLP HTTP).
# Start the stack with: docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
